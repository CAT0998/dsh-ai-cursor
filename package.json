{
  "name": "dsh-ai-cursor",
  "version": "0.11.0",
  "description": "AI 鼠标 (AI cursor) for DeepSeek Harness: a click-through second cursor that shows where the agent is working, plus a floating, collapsible control panel for style, opacity, colour, badge and permission level. Never moves the real mouse pointer.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsdown",
    "build:overlay": "node scripts/build-overlay.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:overlay": "node scripts/run-overlay-selftest.mjs",
    "prepare": "tsdown",
    "prepack": "node scripts/build-overlay.mjs --if-missing && tsdown"
  },
  "dependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.1",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CAT0998/dsh-ai-cursor.git"
  },
  "homepage": "https://github.com/CAT0998/dsh-ai-cursor#readme",
  "bugs": {
    "url": "https://github.com/CAT0998/dsh-ai-cursor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "cursor",
    "overlay",
    "whale",
    "computer-use",
    "agent-cursor",
    "control-panel",
    "permission",
    "windows"
  ]
}
